generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum WaterFeeType {
  INCLUDED
  NOT_INCLUDED
}

enum ElectricityType {
  INCLUDED
  TOKEN
  SEPARATE
}

enum KostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GenderType {
  PUTRA
  PUTRI
  CAMPUR
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique

  kosts     Kost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Facility {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique

  kosts     KostFacility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Kost {
  id                        String          @id @default(cuid())

  name                      String
  slug                      String          @unique
  description               String?
  contactWhatsapp           String

  priceMonthly              Int?
  roomSize                  String?
  distanceToCampusInMeters  Int?

  googleMapsUrl             String?
  genderType                GenderType?

  waterFeeType              WaterFeeType    @default(NOT_INCLUDED)
  electricityType           ElectricityType @default(SEPARATE)

  status                    KostStatus      @default(DRAFT)
  isFeatured                Boolean         @default(false)

  regionId                  String
  region                    Region          @relation(fields: [regionId], references: [id])

  images                    KostImage[]
  facilities                KostFacility[]

  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  publishedAt               DateTime?

  @@index([regionId])
  @@index([status])
  @@index([isFeatured])
  @@index([priceMonthly])
}

model KostImage {
  id        String   @id @default(cuid())
  url       String
  altText   String?
  sortOrder Int      @default(0)

  kostId    String
  kost      Kost     @relation(fields: [kostId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([kostId])
}

model KostFacility {
  kostId     String
  facilityId String

  kost       Kost     @relation(fields: [kostId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([kostId, facilityId])
  @@index([facilityId])
}
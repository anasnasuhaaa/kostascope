generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  createdAt    DateTime @default(now())
  passwordHash String
  role         Role     @default(ADMIN)
  updatedAt    DateTime @updatedAt

  createdKosts Kost[] @relation("KostCreatedBy")
}

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  kosts     Kost[]
}

model Facility {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  kosts     KostFacility[]
}

model Kost {
  id                       String          @id @default(cuid())
  name                     String
  slug                     String          @unique
  description              String?
  contactWhatsapp          String
  roomSize                 String?
  distanceToCampusInMeters Int?
  googleMapsUrl            String?
  genderType               GenderType?
  waterFeeType             WaterFeeType    @default(NOT_INCLUDED)
  electricityType          ElectricityType @default(SEPARATE)
  status                   KostStatus      @default(DRAFT)
  isFeatured               Boolean         @default(false)
  regionId                 String
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  publishedAt              DateTime?
  region                   Region          @relation(fields: [regionId], references: [id])
  facilities               KostFacility[]
  images                   KostImage[]
  prices                   KostPrice[]

  createdById String?
  createdBy   User?   @relation("KostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([regionId])
  @@index([status])
  @@index([isFeatured])
}

model KostPrice {
  id        String        @id @default(cuid())
  type      RentPriceType
  price     Int
  kostId    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  kost      Kost          @relation(fields: [kostId], references: [id], onDelete: Cascade)

  @@unique([kostId, type])
  @@index([kostId])
}

model KostImage {
  id        String   @id @default(cuid())
  url       String
  altText   String?
  sortOrder Int      @default(0)
  kostId    String
  createdAt DateTime @default(now())
  kost      Kost     @relation(fields: [kostId], references: [id], onDelete: Cascade)

  @@index([kostId])
}

model KostFacility {
  kostId     String
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  kost       Kost     @relation(fields: [kostId], references: [id], onDelete: Cascade)

  @@id([kostId, facilityId])
  @@index([facilityId])
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum WaterFeeType {
  INCLUDED
  NOT_INCLUDED
}

enum ElectricityType {
  INCLUDED
  TOKEN
  SEPARATE
}

enum KostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GenderType {
  PUTRA
  PUTRI
  CAMPUR
}

enum RentPriceType {
  MONTHLY
  THREE_MONTHS
  SIX_MONTHS
  YEARLY
}
